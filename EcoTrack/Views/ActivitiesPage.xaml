<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcoTrack.Views.ActivitiesPage"
             Title="Actividades">
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Cabecera fija: menú, título, buscador y filtros -->
        <VerticalStackLayout Grid.Row="0"
                             Padding="{OnIdiom Phone='20,52,20,12', Tablet='40,56,40,14', Desktop='40,48,40,14'}"
                             Spacing="14">

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <ImageButton Grid.Column="0"
                             Source="menu.png"
                             WidthRequest="40"
                             HeightRequest="40"
                             Padding="8"
                             BackgroundColor="Transparent"
                             VerticalOptions="Start"
                             SemanticProperties.Description="Abrir menú"
                             Clicked="AlAbrirMenu" />

                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="Tus actividades" Style="{StaticResource Display}" />
                    <Label x:Name="ResumenLabel" Style="{StaticResource Apoyo}" />
                </VerticalStackLayout>
            </Grid>

            <Border Style="{StaticResource Campo}" Padding="14,0" MinimumHeightRequest="48">
                <Entry x:Name="BuscarEntry"
                       Placeholder="Buscar una actividad"
                       ClearButtonVisibility="WhileEditing"
                       TextChanged="AlBuscar" />
            </Border>

            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8">
                    <Border x:Name="ChipTodas" Style="{StaticResource ChipFiltro}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="AlElegirFiltro" CommandParameter="Todas" />
                        </Border.GestureRecognizers>
                        <Label Text="Todas" Style="{StaticResource ChipTexto}" />
                    </Border>
                    <Border x:Name="ChipTransporte" Style="{StaticResource ChipFiltro}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="AlElegirFiltro" CommandParameter="Transporte" />
                        </Border.GestureRecognizers>
                        <Label Text="Transporte" Style="{StaticResource ChipTexto}" />
                    </Border>
                    <Border x:Name="ChipEnergia" Style="{StaticResource ChipFiltro}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="AlElegirFiltro" CommandParameter="Energia" />
                        </Border.GestureRecognizers>
                        <Label Text="Energía" Style="{StaticResource ChipTexto}" />
                    </Border>
                    <Border x:Name="ChipResiduos" Style="{StaticResource ChipFiltro}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="AlElegirFiltro" CommandParameter="Residuos" />
                        </Border.GestureRecognizers>
                        <Label Text="Residuos" Style="{StaticResource ChipTexto}" />
                    </Border>
                    <Border x:Name="ChipAgua" Style="{StaticResource ChipFiltro}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="AlElegirFiltro" CommandParameter="Agua" />
                        </Border.GestureRecognizers>
                        <Label Text="Agua" Style="{StaticResource ChipTexto}" />
                    </Border>
                </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>

        <!-- Historial: una fila por registro creado -->
        <CollectionView x:Name="ListaCollection"
                        Grid.Row="1"
                        SelectionMode="None"
                        ItemTemplate="{StaticResource RegistroTemplate}"
                        Margin="{OnIdiom Phone='20,4,20,8', Tablet='40,6,40,8', Desktop='40,6,40,8'}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="20,48" Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label x:Name="VacioTitulo" Style="{StaticResource Subtitulo}" HorizontalTextAlignment="Center" />
                    <Label x:Name="VacioDetalle" Style="{StaticResource Apoyo}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <Border Grid.Row="2"
                BackgroundColor="{AppThemeBinding Light={StaticResource Papel}, Dark={StaticResource PapelOscuro}}"
                Stroke="Transparent"
                StrokeThickness="0"
                Padding="{OnIdiom Phone='20,8,20,16', Tablet='40,10,40,20', Desktop='40,10,40,20'}">
            <Button Text="Registrar actividad"
                    Style="{StaticResource BotonPrimario}"
                    MaximumWidthRequest="820"
                    Clicked="AlRegistrar" />
        </Border>
    </Grid>
</ContentPage>