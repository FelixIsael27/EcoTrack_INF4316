<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcoTrack.Views.ActivityFormPage"
             Title="Nueva Actividad"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled">
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Cabecera -->
        <Grid Grid.Row="0"
              Padding="{OnIdiom Phone='20,52,20,12', Tablet='40,56,40,14', Desktop='40,48,40,14'}"
              ColumnDefinitions="*,Auto">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="Nueva actividad" Style="{StaticResource Display}" />
                <Label Text="Los campos con * son obligatorios." Style="{StaticResource Apoyo}" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="Cerrar"
                    Style="{StaticResource BotonTexto}"
                    VerticalOptions="Start"
                    Clicked="AlCerrar" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="{OnIdiom Phone='20,8,20,20', Tablet='40,10,40,24', Desktop='40,10,40,24'}"
                                 Spacing="22"
                                 MaximumWidthRequest="680">

                <!-- Categoría: decide de qué entidad es el registro -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Categoría *" Style="{StaticResource Etiqueta}" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">

                        <Border x:Name="ChipTransporte" Grid.Row="0" Grid.Column="0" Style="{StaticResource ChipCategoria}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="AlElegirCategoria" CommandParameter="Transporte" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="10">
                                <Image Source="cat_transporte.png" HeightRequest="24" WidthRequest="24" />
                                <Label Text="Transporte" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border x:Name="ChipEnergia" Grid.Row="0" Grid.Column="1" Style="{StaticResource ChipCategoria}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="AlElegirCategoria" CommandParameter="Energia" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="10">
                                <Image Source="cat_energia.png" HeightRequest="24" WidthRequest="24" />
                                <Label Text="Energía" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border x:Name="ChipResiduos" Grid.Row="1" Grid.Column="0" Style="{StaticResource ChipCategoria}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="AlElegirCategoria" CommandParameter="Residuos" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="10">
                                <Image Source="cat_residuos.png" HeightRequest="24" WidthRequest="24" />
                                <Label Text="Residuos" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border x:Name="ChipAgua" Grid.Row="1" Grid.Column="1" Style="{StaticResource ChipCategoria}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="AlElegirCategoria" CommandParameter="Agua" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="10">
                                <Image Source="cat_agua.png" HeightRequest="24" WidthRequest="24" />
                                <Label Text="Agua" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- Actividad (texto obligatorio) -->
                <VerticalStackLayout>
                    <Label Text="Actividad *" Style="{StaticResource Etiqueta}" />
                    <Border Style="{StaticResource Campo}">
                        <Entry x:Name="DescripcionEntry" MaxLength="60" />
                    </Border>
                    <Label x:Name="ErrDescripcion" Style="{StaticResource MensajeError}" />
                </VerticalStackLayout>

                <!-- Tipo (lista que cambia según la categoría) -->
                <VerticalStackLayout>
                    <Label x:Name="TipoLabel" Style="{StaticResource Etiqueta}" />
                    <Border Style="{StaticResource Campo}" Padding="14,2">
                        <Picker x:Name="TipoPicker"
                                Title="Elige una opción"
                                SelectedIndexChanged="AlCambiarDatos" />
                    </Border>
                    <Label x:Name="ErrTipo" Style="{StaticResource MensajeError}" />
                </VerticalStackLayout>

                <!-- Cantidad (número obligatorio, mayor que 0) -->
                <VerticalStackLayout>
                    <Label x:Name="CantidadLabel" Style="{StaticResource Etiqueta}" />
                    <Border Style="{StaticResource Campo}">
                        <Entry x:Name="CantidadEntry"
                               Placeholder="0"
                               Keyboard="Numeric"
                               TextChanged="AlCambiarCantidad" />
                    </Border>
                    <Label x:Name="ErrCantidad" Style="{StaticResource MensajeError}" />
                </VerticalStackLayout>

                <!-- Fecha (no puede ser futura: se limita en el código) -->
                <VerticalStackLayout>
                    <Label Text="Fecha *" Style="{StaticResource Etiqueta}" />
                    <Border Style="{StaticResource Campo}">
                        <DatePicker x:Name="FechaPicker" Format="dd/MM/yyyy" VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <!-- Foto (opcional) -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Foto del registro (opcional)" Style="{StaticResource Etiqueta}" />
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Superficie}, Dark={StaticResource SuperficieOscura}}"
                            Stroke="{AppThemeBinding Light={StaticResource Borde}, Dark={StaticResource BordeOscuro}}"
                            StrokeThickness="1.5"
                            StrokeDashArray="8,5"
                            StrokeDashOffset="0"
                            Padding="0"
                            HeightRequest="150">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="AlElegirFoto" />
                        </Border.GestureRecognizers>
                        <Grid>
                            <VerticalStackLayout x:Name="FotoVacia" Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
                                <Image Source="camara.png" HeightRequest="30" />
                                <Label Text="Añade una foto de la actividad" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                <Label Text="Elige una imagen de tu galería" Style="{StaticResource Apoyo}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <Image x:Name="FotoPreview" Aspect="AspectFill" IsVisible="False" />
                        </Grid>
                    </Border>
                    <Button x:Name="QuitarFotoButton"
                            Text="Quitar foto"
                            Style="{StaticResource BotonTexto}"
                            HorizontalOptions="End"
                            IsVisible="False"
                            Clicked="AlQuitarFoto" />
                </VerticalStackLayout>

                <!-- Nota (opcional) -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Nota (opcional)" Style="{StaticResource Etiqueta}" />
                    <Border Style="{StaticResource Campo}" Padding="12,6">
                        <Editor x:Name="NotaEditor"
                                Placeholder="Algún detalle que quieras recordar"
                                MaxLength="200"
                                HeightRequest="90" />
                    </Border>
                </VerticalStackLayout>

                <!-- Vista previa del cálculo -->
                <Border Style="{StaticResource Panel}" Padding="18">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Ahorro estimado" Style="{StaticResource ApoyoClaro}" />
                            <Label Text="Se calcula con tu tipo y cantidad" TextColor="{StaticResource Blanco}" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <Label x:Name="AhorroLabel"
                               Grid.Column="1"
                               Text="— kg CO₂"
                               TextColor="{StaticResource Lima}"
                               FontSize="{StaticResource TxSubtitulo}"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Acciones -->
        <Border Grid.Row="2"
                BackgroundColor="{AppThemeBinding Light={StaticResource Papel}, Dark={StaticResource PapelOscuro}}"
                Stroke="Transparent"
                StrokeThickness="0"
                Padding="{OnIdiom Phone='20,8,20,16', Tablet='40,10,40,20', Desktop='40,10,40,20'}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" MaximumWidthRequest="680">
                <Button Grid.Column="0"
                        Text="Cancelar"
                        Style="{StaticResource BotonSecundario}"
                        WidthRequest="120"
                        Clicked="AlCerrar" />
                <Button Grid.Column="1"
                        Text="Guardar actividad"
                        Style="{StaticResource BotonPrimario}"
                        Clicked="AlGuardar" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>