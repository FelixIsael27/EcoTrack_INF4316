<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EcoTrack.ViewsModels"
             x:Class="EcoTrack.Views.ActivityFormPage"
             x:DataType="vm:ActivityFormViewModel"
             Title="Nueva Actividad"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Cabecera -->
        <Grid Grid.Row="0"
              Padding="{OnIdiom Phone='20,52,20,12', Tablet='40,56,40,14', Desktop='40,48,40,14'}"
              ColumnDefinitions="*,Auto">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="Nueva actividad" Style="{StaticResource Display}" />
                <Label Text="Los campos con * son obligatorios." Style="{StaticResource Apoyo}" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="Cerrar"
                    Style="{StaticResource BotonTexto}"
                    VerticalOptions="Start"
                    Command="{Binding CerrarCommand}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="{OnIdiom Phone='20,8,20,20', Tablet='40,10,40,24', Desktop='40,10,40,24'}"
                                 Spacing="22"
                                 MaximumWidthRequest="680">

                <!-- Categoría: elige cuál de los 4 formularios se muestra -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Categoría *" Style="{StaticResource Etiqueta}" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ChipCategoria}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SeleccionarCategoriaCommand}" CommandParameter="Transporte" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding EsTransporte}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource HojaClara}, Dark=#18332A}" />
                                    <Setter Property="Stroke" Value="{StaticResource Hoja}" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                            </Border.Triggers>
                            <HorizontalStackLayout Spacing="10">
                                <Image Source="cat_transporte.png" HeightRequest="24" WidthRequest="24" />
                                <Label Text="Transporte" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ChipCategoria}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SeleccionarCategoriaCommand}" CommandParameter="Energia" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding EsEnergia}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource HojaClara}, Dark=#18332A}" />
                                    <Setter Property="Stroke" Value="{StaticResource Hoja}" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                            </Border.Triggers>
                            <HorizontalStackLayout Spacing="10">
                                <Image Source="cat_energia.png" HeightRequest="24" WidthRequest="24" />
                                <Label Text="Energía" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ChipCategoria}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SeleccionarCategoriaCommand}" CommandParameter="Residuos" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding EsResiduos}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource HojaClara}, Dark=#18332A}" />
                                    <Setter Property="Stroke" Value="{StaticResource Hoja}" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                            </Border.Triggers>
                            <HorizontalStackLayout Spacing="10">
                                <Image Source="cat_residuos.png" HeightRequest="24" WidthRequest="24" />
                                <Label Text="Residuos" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ChipCategoria}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SeleccionarCategoriaCommand}" CommandParameter="Agua" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding EsAgua}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource HojaClara}, Dark=#18332A}" />
                                    <Setter Property="Stroke" Value="{StaticResource Hoja}" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                            </Border.Triggers>
                            <HorizontalStackLayout Spacing="10">
                                <Image Source="cat_agua.png" HeightRequest="24" WidthRequest="24" />
                                <Label Text="Agua" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- Actividad -->
                <VerticalStackLayout>
                    <Label Text="Actividad *" Style="{StaticResource Etiqueta}" />
                    <Border Style="{StaticResource Campo}">
                        <Entry Text="{Binding Actual.Descripcion}"
                               Placeholder="{Binding Actual.PlaceholderDescripcion}" />
                    </Border>
                    <Label Text="{Binding Actual.ErrorDescripcion}"
                           IsVisible="{Binding Actual.TieneErrorDescripcion}"
                           Style="{StaticResource MensajeError}" />
                </VerticalStackLayout>

                <!-- Tipo (la etiqueta y las opciones cambian con la categoría) -->
                <VerticalStackLayout>
                    <Label Text="{Binding Actual.EtiquetaTipo}" Style="{StaticResource Etiqueta}" />
                    <Border Style="{StaticResource Campo}" Padding="14,2">
                        <Picker Title="Elige una opción"
                                ItemsSource="{Binding Actual.OpcionesTipo}"
                                SelectedItem="{Binding Actual.Tipo}" />
                    </Border>
                    <Label Text="{Binding Actual.ErrorTipo}"
                           IsVisible="{Binding Actual.TieneErrorTipo}"
                           Style="{StaticResource MensajeError}" />
                </VerticalStackLayout>

                <!-- Cantidad -->
                <VerticalStackLayout>
                    <Label Text="{Binding Actual.EtiquetaCantidad}" Style="{StaticResource Etiqueta}" />
                    <Border Style="{StaticResource Campo}">
                        <Entry Text="{Binding Actual.Cantidad}"
                               Placeholder="0"
                               Keyboard="Numeric" />
                    </Border>
                    <Label Text="{Binding Actual.ErrorCantidad}"
                           IsVisible="{Binding Actual.TieneErrorCantidad}"
                           Style="{StaticResource MensajeError}" />
                </VerticalStackLayout>

                <!-- Fecha -->
                <VerticalStackLayout>
                    <Label Text="Fecha *" Style="{StaticResource Etiqueta}" />
                    <Border Style="{StaticResource Campo}">
                        <DatePicker Date="{Binding Actual.Fecha}"
                                    MinimumDate="{Binding Actual.FechaMinima}"
                                    MaximumDate="{Binding Actual.FechaMaxima}"
                                    Format="dd/MM/yyyy"
                                    VerticalOptions="Center" />
                    </Border>
                    <Label Text="{Binding Actual.ErrorFecha}"
                           IsVisible="{Binding Actual.TieneErrorFecha}"
                           Style="{StaticResource MensajeError}" />
                </VerticalStackLayout>

                <!-- Foto (opcional) -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Foto del registro (opcional)" Style="{StaticResource Etiqueta}" />
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Superficie}, Dark={StaticResource SuperficieOscura}}"
                            Stroke="{AppThemeBinding Light={StaticResource Borde}, Dark={StaticResource BordeOscuro}}"
                            StrokeThickness="1.5"
                            StrokeDashArray="8,5"
                            StrokeDashOffset="0"
                            Padding="0"
                            HeightRequest="150">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Actual.ElegirFotoCommand}" />
                        </Border.GestureRecognizers>
                        <Grid>
                            <VerticalStackLayout Spacing="8"
                                                 VerticalOptions="Center"
                                                 HorizontalOptions="Center"
                                                 IsVisible="{Binding Actual.SinFoto}">
                                <Image Source="camara.png" HeightRequest="30" />
                                <Label Text="Añade una foto de la actividad" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                <Label Text="Elige una imagen de tu galería" Style="{StaticResource Apoyo}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <Image Source="{Binding Actual.FotoSource}"
                                   Aspect="AspectFill"
                                   IsVisible="{Binding Actual.TieneFoto}" />
                        </Grid>
                    </Border>
                    <Button Text="Quitar foto"
                            Style="{StaticResource BotonTexto}"
                            HorizontalOptions="End"
                            IsVisible="{Binding Actual.TieneFoto}"
                            Command="{Binding Actual.QuitarFotoCommand}" />
                    <Label Text="{Binding Actual.ErrorFoto}"
                           IsVisible="{Binding Actual.TieneErrorFoto}"
                           Style="{StaticResource MensajeError}" />
                </VerticalStackLayout>

                <!-- Nota (opcional) -->
                <VerticalStackLayout>
                    <Label Text="Nota (opcional)" Style="{StaticResource Etiqueta}" />
                    <Border Style="{StaticResource Campo}" Padding="12,6">
                        <Editor Text="{Binding Actual.Nota}"
                                Placeholder="Algún detalle que quieras recordar"
                                HeightRequest="90" />
                    </Border>
                    <Label Text="{Binding Actual.ErrorNota}"
                           IsVisible="{Binding Actual.TieneErrorNota}"
                           Style="{StaticResource MensajeError}" />
                </VerticalStackLayout>

                <!-- Vista previa del cálculo -->
                <Border Style="{StaticResource Panel}" Padding="18">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Ahorro estimado" Style="{StaticResource ApoyoClaro}" />
                            <Label Text="Se calcula con tu tipo y cantidad" TextColor="{StaticResource Blanco}" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="{Binding Actual.AhorroTexto}"
                               TextColor="{StaticResource Lima}"
                               FontSize="{StaticResource TxSubtitulo}"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Acciones -->
        <Border Grid.Row="2"
                BackgroundColor="{AppThemeBinding Light={StaticResource Papel}, Dark={StaticResource PapelOscuro}}"
                Stroke="Transparent"
                StrokeThickness="0"
                Padding="{OnIdiom Phone='20,8,20,16', Tablet='40,10,40,20', Desktop='40,10,40,20'}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" MaximumWidthRequest="680">
                <Button Grid.Column="0"
                        Text="Cerrar"
                        Style="{StaticResource BotonSecundario}"
                        WidthRequest="120"
                        Command="{Binding CerrarCommand}" />
                <Button Grid.Column="1"
                        Text="Guardar actividad"
                        Style="{StaticResource BotonPrimario}"
                        Command="{Binding Actual.GuardarCommand}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>