<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcoTrack.Views.DashboardPage"
             Title="Inicio">
    
    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <Grid Padding="{OnIdiom Phone='20,52,20,24', Tablet='40,56,40,32', Desktop='40,48,40,32'}"
                  MaximumWidthRequest="820"
                  HorizontalOptions="Fill"
                  RowSpacing="22"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

                <!-- Cabecera: menú + saludo + avatar -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <ImageButton Grid.Column="0"
                                 Source="menu.png"
                                 WidthRequest="40"
                                 HeightRequest="40"
                                 Padding="8"
                                 BackgroundColor="Transparent"
                                 VerticalOptions="Start"
                                 SemanticProperties.Description="Abrir menú"
                                 Clicked="AlAbrirMenu" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label x:Name="SaludoLabel" Text="Hola" Style="{StaticResource Display}" />
                        <Label x:Name="FechaLabel" Style="{StaticResource Apoyo}" />
                    </VerticalStackLayout>

                    <Border Grid.Column="2"
                            BackgroundColor="{StaticResource HojaClara}"
                            Stroke="Transparent"
                            HeightRequest="46"
                            WidthRequest="46"
                            Padding="0"
                            VerticalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="23" />
                        </Border.StrokeShape>
                        <Label x:Name="AvatarLabel"
                               Text="A"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Hoja}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Dato principal de la semana -->
                <Border Grid.Row="1" Style="{StaticResource Panel}">
                    <VerticalStackLayout Spacing="18">

                        <Label Text="Huella evitada esta semana" Style="{StaticResource ApoyoClaro}" />

                        <HorizontalStackLayout Spacing="8" VerticalOptions="End">
                            <Label x:Name="TotalSemanaLabel" Text="0" Style="{StaticResource Cifra}" />
                            <Label Text="kg CO₂"
                                   TextColor="{StaticResource Lima}"
                                   FontAttributes="Bold"
                                   VerticalOptions="End"
                                   Margin="0,0,0,6" />
                        </HorizontalStackLayout>

                        <Label x:Name="ComparacionLabel"
                               TextColor="#A9C3B4"
                               FontSize="{StaticResource TxApoyo}" />

                        <!-- Semana: una barra por día (alturas calculadas en el código) -->
                        <Grid ColumnDefinitions="*,*,*,*,*,*,*"
                              ColumnSpacing="8"
                              HeightRequest="96">

                            <Grid Grid.Column="0" RowDefinitions="*,Auto" RowSpacing="8">
                                <BoxView x:Name="Barra0" Grid.Row="0" Color="#3C6A55" CornerRadius="6" HeightRequest="6" VerticalOptions="End" />
                                <Label x:Name="Dia0" Grid.Row="1" Text="L" Style="{StaticResource ApoyoClaro}" HorizontalOptions="Center" />
                            </Grid>
                            <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="8">
                                <BoxView x:Name="Barra1" Grid.Row="0" Color="#3C6A55" CornerRadius="6" HeightRequest="6" VerticalOptions="End" />
                                <Label x:Name="Dia1" Grid.Row="1" Text="M" Style="{StaticResource ApoyoClaro}" HorizontalOptions="Center" />
                            </Grid>
                            <Grid Grid.Column="2" RowDefinitions="*,Auto" RowSpacing="8">
                                <BoxView x:Name="Barra2" Grid.Row="0" Color="#3C6A55" CornerRadius="6" HeightRequest="6" VerticalOptions="End" />
                                <Label x:Name="Dia2" Grid.Row="1" Text="M" Style="{StaticResource ApoyoClaro}" HorizontalOptions="Center" />
                            </Grid>
                            <Grid Grid.Column="3" RowDefinitions="*,Auto" RowSpacing="8">
                                <BoxView x:Name="Barra3" Grid.Row="0" Color="#3C6A55" CornerRadius="6" HeightRequest="6" VerticalOptions="End" />
                                <Label x:Name="Dia3" Grid.Row="1" Text="J" Style="{StaticResource ApoyoClaro}" HorizontalOptions="Center" />
                            </Grid>
                            <Grid Grid.Column="4" RowDefinitions="*,Auto" RowSpacing="8">
                                <BoxView x:Name="Barra4" Grid.Row="0" Color="#3C6A55" CornerRadius="6" HeightRequest="6" VerticalOptions="End" />
                                <Label x:Name="Dia4" Grid.Row="1" Text="V" Style="{StaticResource ApoyoClaro}" HorizontalOptions="Center" />
                            </Grid>
                            <Grid Grid.Column="5" RowDefinitions="*,Auto" RowSpacing="8">
                                <BoxView x:Name="Barra5" Grid.Row="0" Color="#3C6A55" CornerRadius="6" HeightRequest="6" VerticalOptions="End" />
                                <Label x:Name="Dia5" Grid.Row="1" Text="S" Style="{StaticResource ApoyoClaro}" HorizontalOptions="Center" />
                            </Grid>
                            <Grid Grid.Column="6" RowDefinitions="*,Auto" RowSpacing="8">
                                <BoxView x:Name="Barra6" Grid.Row="0" Color="#3C6A55" CornerRadius="6" HeightRequest="6" VerticalOptions="End" />
                                <Label x:Name="Dia6" Grid.Row="1" Text="D" Style="{StaticResource ApoyoClaro}" HorizontalOptions="Center" />
                            </Grid>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Desglose por categoría (esta semana) -->
                <Grid Grid.Row="2"
                      ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="12">

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Tarjeta}" Padding="14">
                        <Grid ColumnDefinitions="3,*" ColumnSpacing="10">
                            <BoxView Grid.Column="0" Color="{StaticResource Transporte}" CornerRadius="2" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Transporte" Style="{StaticResource Apoyo}" />
                                <Label x:Name="TransporteLabel" Text="0" Style="{StaticResource Subtitulo}" />
                                <Label Text="km limpios" Style="{StaticResource Apoyo}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Tarjeta}" Padding="14">
                        <Grid ColumnDefinitions="3,*" ColumnSpacing="10">
                            <BoxView Grid.Column="0" Color="{StaticResource Energia}" CornerRadius="2" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Energía" Style="{StaticResource Apoyo}" />
                                <Label x:Name="EnergiaLabel" Text="0" Style="{StaticResource Subtitulo}" />
                                <Label Text="kWh ahorrados" Style="{StaticResource Apoyo}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Tarjeta}" Padding="14">
                        <Grid ColumnDefinitions="3,*" ColumnSpacing="10">
                            <BoxView Grid.Column="0" Color="{StaticResource Residuos}" CornerRadius="2" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Residuos" Style="{StaticResource Apoyo}" />
                                <Label x:Name="ResiduosLabel" Text="0" Style="{StaticResource Subtitulo}" />
                                <Label Text="kg reciclados" Style="{StaticResource Apoyo}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Tarjeta}" Padding="14">
                        <Grid ColumnDefinitions="3,*" ColumnSpacing="10">
                            <BoxView Grid.Column="0" Color="{StaticResource Agua}" CornerRadius="2" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Agua" Style="{StaticResource Apoyo}" />
                                <Label x:Name="AguaLabel" Text="0" Style="{StaticResource Subtitulo}" />
                                <Label Text="litros ahorrados" Style="{StaticResource Apoyo}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Consejo del día -->
                <Border Grid.Row="3"
                        Style="{StaticResource Tarjeta}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource HojaClara}, Dark=#18332A}"
                        Stroke="{AppThemeBinding Light=#CBE3D5, Dark=#27392F}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Image Grid.Column="0"
                               Source="marca.png"
                               HeightRequest="30"
                               VerticalOptions="Start" />
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Consejo de hoy" Style="{StaticResource Subtitulo}" />
                            <Label x:Name="ConsejoLabel" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Últimos registros -->
                <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Últimos registros" Style="{StaticResource Titulo}" />
                    <Button Grid.Column="1"
                            Text="Ver historial"
                            Style="{StaticResource BotonTexto}"
                            VerticalOptions="Center"
                            Clicked="AlVerHistorial" />
                </Grid>

                <VerticalStackLayout x:Name="UltimosLayout"
                                     Grid.Row="5"
                                     Spacing="10"
                                     BindableLayout.ItemTemplate="{StaticResource RegistroTemplate}">
                    <BindableLayout.EmptyView>
                        <Label Text="Todavía no tienes registros. Toca «Registrar actividad» para crear el primero."
                               Style="{StaticResource Apoyo}" />
                    </BindableLayout.EmptyView>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <!-- Acción principal, siempre visible -->
        <Border Grid.Row="1"
                BackgroundColor="{AppThemeBinding Light={StaticResource Papel}, Dark={StaticResource PapelOscuro}}"
                Stroke="Transparent"
                StrokeThickness="0"
                Padding="{OnIdiom Phone='20,8,20,16', Tablet='40,10,40,20', Desktop='40,10,40,20'}">
            <Button Text="Registrar actividad"
                    Style="{StaticResource BotonPrimario}"
                    MaximumWidthRequest="820"
                    Clicked="AlRegistrar" />
        </Border>
    </Grid>
</ContentPage>