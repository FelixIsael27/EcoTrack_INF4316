<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===================== Escala tipográfica ===================== -->
    <x:Double x:Key="TxCifra">42</x:Double>
    <x:Double x:Key="TxDisplay">30</x:Double>
    <x:Double x:Key="TxTitulo">22</x:Double>
    <x:Double x:Key="TxSubtitulo">17</x:Double>
    <x:Double x:Key="TxCuerpo">15</x:Double>
    <x:Double x:Key="TxApoyo">13</x:Double>

    <!-- Espaciado base de 8; el lateral crece en tablet y escritorio -->
    <Thickness x:Key="MargenPagina">20,0</Thickness>

    <!-- ===================== Página ===================== -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource Papel}, Dark={StaticResource PapelOscuro}}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource Papel}, Dark={StaticResource PapelOscuro}}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource Hoja}" />
        <Setter Property="Shell.TitleColor"
                Value="{AppThemeBinding Light={StaticResource Tinta}, Dark={StaticResource TintaClara}}" />
        <Setter Property="Shell.TabBarBackgroundColor"
                Value="{AppThemeBinding Light={StaticResource Superficie}, Dark={StaticResource SuperficieOscura}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource Hoja}" />
        <Setter Property="Shell.TabBarUnselectedColor"
                Value="{AppThemeBinding Light={StaticResource TintaSuave}, Dark={StaticResource TintaClaraSuave}}" />
    </Style>

    <!-- ===================== Texto ===================== -->
    <Style TargetType="Label">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Tinta}, Dark={StaticResource TintaClara}}" />
        <Setter Property="FontSize" Value="{StaticResource TxCuerpo}" />
        <Setter Property="LineHeight" Value="1.35" />
    </Style>

    <Style x:Key="Cifra" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource TxCifra}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource Blanco}" />
        <Setter Property="LineHeight" Value="1" />
    </Style>

    <Style x:Key="Display" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource TxDisplay}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="Titulo" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource TxTitulo}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="Subtitulo" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource TxSubtitulo}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="Apoyo" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource TxApoyo}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TintaSuave}, Dark={StaticResource TintaClaraSuave}}" />
    </Style>

    <Style x:Key="ApoyoClaro" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource TxApoyo}" />
        <Setter Property="TextColor" Value="#A9C3B4" />
    </Style>

    <!-- ===================== Contenedores ===================== -->
    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource Superficie}, Dark={StaticResource SuperficieOscura}}" />
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource Borde}, Dark={StaticResource BordeOscuro}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="14" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Panel oscuro: solo para el dato principal de cada pantalla -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Pino}" />
        <Setter Property="Stroke" Value="{StaticResource Pino}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="18" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Separador" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color"
                Value="{AppThemeBinding Light={StaticResource Borde}, Dark={StaticResource BordeOscuro}}" />
    </Style>

    <!-- ===================== Botones ===================== -->
    <Style x:Key="BotonPrimario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Hoja}" />
        <Setter Property="TextColor" Value="{StaticResource Blanco}" />
        <Setter Property="FontSize" Value="{StaticResource TxCuerpo}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="Padding" Value="20,0" />
    </Style>

    <Style x:Key="BotonSecundario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Tinta}, Dark={StaticResource TintaClara}}" />
        <Setter Property="BorderColor"
                Value="{AppThemeBinding Light={StaticResource Borde}, Dark={StaticResource BordeOscuro}}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontSize" Value="{StaticResource TxCuerpo}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="52" />
    </Style>

    <Style x:Key="BotonTexto" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Hoja}" />
        <Setter Property="FontSize" Value="{StaticResource TxApoyo}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HeightRequest" Value="32" />
    </Style>

    <!-- ===================== Formulario ===================== -->
    <Style x:Key="Etiqueta" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource TxApoyo}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TintaSuave}, Dark={StaticResource TintaClaraSuave}}" />
        <Setter Property="Margin" Value="2,0,0,6" />
    </Style>

    <Style x:Key="Campo" TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource Superficie}, Dark={StaticResource SuperficieOscura}}" />
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource Borde}, Dark={StaticResource BordeOscuro}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="14,2" />
        <Setter Property="MinimumHeightRequest" Value="52" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="12" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Tinta}, Dark={StaticResource TintaClara}}" />
        <Setter Property="PlaceholderColor"
                Value="{AppThemeBinding Light={StaticResource TintaSuave}, Dark={StaticResource TintaClaraSuave}}" />
        <Setter Property="FontSize" Value="{StaticResource TxCuerpo}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="HeightRequest" Value="48" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Tinta}, Dark={StaticResource TintaClara}}" />
        <Setter Property="PlaceholderColor"
                Value="{AppThemeBinding Light={StaticResource TintaSuave}, Dark={StaticResource TintaClaraSuave}}" />
        <Setter Property="FontSize" Value="{StaticResource TxCuerpo}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Tinta}, Dark={StaticResource TintaClara}}" />
        <Setter Property="FontSize" Value="{StaticResource TxCuerpo}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Tinta}, Dark={StaticResource TintaClara}}" />
        <Setter Property="TitleColor"
                Value="{AppThemeBinding Light={StaticResource TintaSuave}, Dark={StaticResource TintaClaraSuave}}" />
        <Setter Property="FontSize" Value="{StaticResource TxCuerpo}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource Hoja}" />
    </Style>

</ResourceDictionary>
