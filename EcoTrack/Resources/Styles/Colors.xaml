<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Base: verde pino profundo + papel reciclado. -->
    <Color x:Key="Pino">#0F2B22</Color>
    <Color x:Key="PinoSuave">#1B3F33</Color>
    <Color x:Key="Papel">#F3F5F0</Color>
    <Color x:Key="Superficie">#FFFFFF</Color>
    <Color x:Key="Borde">#DCE4DB</Color>

    <!-- Acción y dato -->
    <Color x:Key="Hoja">#1E7A4D</Color>
    <Color x:Key="HojaClara">#E3F0E8</Color>
    <Color x:Key="Lima">#C9E265</Color>

    <!-- Código de categorías: cada actividad tiene su color fijo -->
    <Color x:Key="Transporte">#2E7E8F</Color>
    <Color x:Key="Energia">#C97B2B</Color>
    <Color x:Key="Residuos">#6F8F3F</Color>
    <Color x:Key="Agua">#3E6EA8</Color>

    <!-- Texto -->
    <Color x:Key="Tinta">#12241D</Color>
    <Color x:Key="TintaSuave">#5D6E66</Color>
    <Color x:Key="Alerta">#B3402F</Color>

    <!-- Modo oscuro -->
    <Color x:Key="PapelOscuro">#0B1712</Color>
    <Color x:Key="SuperficieOscura">#14261F</Color>
    <Color x:Key="BordeOscuro">#27392F</Color>
    <Color x:Key="TintaClara">#EAF2EC</Color>
    <Color x:Key="TintaClaraSuave">#9CB1A7</Color>

    <!-- Neutros -->
    <Color x:Key="Blanco">#FFFFFF</Color>
    <Color x:Key="Negro">#000000</Color>

</ResourceDictionary>